{
	"useTabs": true,
	"singleQuote": true,
	"trailingComma": "none",
	"printWidth": 100,
	"plugins": ["prettier-plugin-svelte"],
	"overrides": [
		{
			"files": "*.svelte",
			"options": {
				"parser": "svelte"
			}
		},
		{
			"files": "*.md",
			"options": {
				"embeddedLanguageFormatting": "off"
			}
		},
		{
			"files": "docs/**/*.md",
			"excludeFiles": [
				"docs/changelog.md",
				"docs/changelog/**",
				"docs/contributing/casebook.md",
				"docs/contributing/commit-conventions.md",
				"docs/contributing/rules.md",
				"docs/guide/plugin-gallery.md",
				"docs/design/invariants/tested.md"
			],
			"options": {
				"proseWrap": "never"
			}
		}
	]
}
