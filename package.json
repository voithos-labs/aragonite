{
	"name": "@voithos-labs/aragonite",
	"version": "0.11.3",
	"description": "cute svelte-based markdown editor lib with actual rich markdown editing",
	"keywords": [
		"markdown-editor",
		"markdown",
		"gfm",
		"wysiwyg",
		"rich-text-editor",
		"block-editor",
		"live-preview",
		"lossless",
		"contenteditable",
		"svelte",
		"react",
		"vue",
		"typescript"
	],
	"homepage": "https://aragonite.dev",
	"bugs": {
		"url": "https://github.com/voithos-labs/aragonite/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/voithos-labs/aragonite.git"
	},
	"author": "voithos-labs",
	"type": "module",
	"license": "MPL-2.0",
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=22.17.0"
		}
	},
	"workspaces": [
		"packages/*"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/prebuilt/index.js"
		},
		"./plugin": {
			"types": "./dist/plugin.d.ts",
			"svelte": "./dist/plugin.js",
			"default": "./dist/prebuilt/plugin.js"
		},
		"./svelte": {
			"types": "./dist/svelte.d.ts",
			"svelte": "./dist/svelte.js",
			"default": "./dist/prebuilt/svelte.js"
		},
		"./plugins/admonitions": {
			"types": "./dist/plugins/admonitions/index.d.ts",
			"svelte": "./dist/plugins/admonitions/index.js",
			"default": "./dist/prebuilt/plugins/admonitions/index.js"
		},
		"./plugins/details": {
			"types": "./dist/plugins/details/index.d.ts",
			"svelte": "./dist/plugins/details/index.js",
			"default": "./dist/prebuilt/plugins/details/index.js"
		},
		"./plugins/emoji": {
			"types": "./dist/plugins/emoji/index.d.ts",
			"svelte": "./dist/plugins/emoji/index.js",
			"default": "./dist/prebuilt/plugins/emoji/index.js"
		},
		"./plugins/footnotes": {
			"types": "./dist/plugins/footnotes/index.d.ts",
			"svelte": "./dist/plugins/footnotes/index.js",
			"default": "./dist/prebuilt/plugins/footnotes/index.js"
		},
		"./plugins/latex": {
			"types": "./dist/plugins/latex/index.d.ts",
			"svelte": "./dist/plugins/latex/index.js",
			"default": "./dist/prebuilt/plugins/latex/index.js"
		},
		"./plugins/latex/renderer": {
			"types": "./dist/plugins/latex/renderer.d.ts",
			"svelte": "./dist/plugins/latex/renderer.js",
			"default": "./dist/prebuilt/plugins/latex/renderer.js"
		},
		"./plugins/mermaid": {
			"types": "./dist/plugins/mermaid/index.d.ts",
			"svelte": "./dist/plugins/mermaid/index.js",
			"default": "./dist/prebuilt/plugins/mermaid/index.js"
		},
		"./plugins/mermaid/renderer": {
			"types": "./dist/plugins/mermaid/renderer.d.ts",
			"svelte": "./dist/plugins/mermaid/renderer.js",
			"default": "./dist/prebuilt/plugins/mermaid/renderer.js"
		},
		"./plugins/parrot": {
			"types": "./dist/plugins/parrot/index.d.ts",
			"svelte": "./dist/plugins/parrot/index.js",
			"default": "./dist/prebuilt/plugins/parrot/index.js"
		},
		"./plugins/toc": {
			"types": "./dist/plugins/toc/index.d.ts",
			"svelte": "./dist/plugins/toc/index.js",
			"default": "./dist/prebuilt/plugins/toc/index.js"
		},
		"./plugins/highlight-occurrences": {
			"types": "./dist/plugins/highlight-occurrences/index.d.ts",
			"svelte": "./dist/plugins/highlight-occurrences/index.js",
			"default": "./dist/prebuilt/plugins/highlight-occurrences/index.js"
		},
		"./plugins/slash-commands": {
			"types": "./dist/plugins/slash-commands/index.d.ts",
			"svelte": "./dist/plugins/slash-commands/index.js",
			"default": "./dist/prebuilt/plugins/slash-commands/index.js"
		},
		"./testing": {
			"types": "./dist/testing.d.ts",
			"svelte": "./dist/testing.js",
			"default": "./dist/prebuilt/testing.js"
		},
		"./dev-checks": {
			"aragonite-source": "./src/lib/dev-checks.ts",
			"types": "./dist/dev-checks.d.ts",
			"production": "./dist/dev-checks-stripped.js",
			"default": "./dist/dev-checks.js"
		},
		"./styles/editor-theme.css": "./dist/styles/editor-theme.css",
		"./style.css": "./dist/prebuilt/style.css",
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"docs/guide",
		"THIRD-PARTY-NOTICES.md"
	],
	"sideEffects": [
		"**/*.css",
		"./dist/components/built-in-blocks.js",
		"./dist/core/parsers/built-in-openers.js",
		"./dist/schema/built-in-descriptors.js",
		"./dist/plugins/latex/renderer.js",
		"./dist/prebuilt/**/*.js"
	],
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"build:e2e": "node scripts/run-with-env.mjs NODE_ENV=development ARAGONITE_E2E_BUILD=1 -- vite build",
		"preview:e2e": "node scripts/run-with-env.mjs ARAGONITE_E2E_BUILD=1 -- vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "npm run test:editor && npm run test:e2e",
		"test:editor": "vitest run",
		"test:editor:conformance": "vitest run src/lib/test/gfm-conformance",
		"test:editor:core": "vitest run src/lib/test/core",
		"test:editor:decorations": "vitest run src/lib/test/decorations",
		"test:editor:tree-ops": "vitest run src/lib/test/tree-operations",
		"test:editor:editor-actions": "vitest run src/lib/test/editor-actions",
		"test:editor:browser": "vitest run src/lib/test/browser",
		"test:editor:caret": "vitest run src/lib/test/caret",
		"test:editor:schema": "vitest run src/lib/test/schema",
		"test:editor:windowing": "vitest run src/lib/test/windowing",
		"test:editor:block-lists": "vitest run src/lib/test/block-lists",
		"test:editor:selection": "vitest run src/lib/test/selection",
		"test:editor:blocks": "vitest run src/lib/test/blocks",
		"test:editor:image": "vitest run src/lib/test/image",
		"test:editor:plugins": "vitest run src/lib/test/plugins",
		"test:editor:simulation": "vitest run src/lib/test/simulation",
		"test:editor:undo": "vitest run src/lib/test/undo",
		"test:editor:debug": "vitest run src/lib/test/debug",
		"test:editor:invariants": "vitest run src/lib/test/invariants",
		"test:editor:search": "vitest run src/lib/test/search",
		"test:editor:perf": "vitest run src/lib/test/perf",
		"test:editor:exhaustive": "vitest run src/lib/test/exhaustive",
		"test:e2e": "playwright test",
		"test:e2e:top": "playwright test --project=e2e-top",
		"test:e2e:blocks": "playwright test --project=e2e-blocks",
		"test:e2e:decorations": "playwright test --project=e2e-decorations",
		"test:e2e:plugins": "playwright test --project=e2e-plugins",
		"test:e2e:presentation": "playwright test --project=e2e-presentation",
		"test:e2e:blocks:list": "playwright test --project=e2e-blocks blocks/list",
		"test:e2e:blocks:code": "playwright test --project=e2e-blocks blocks/code",
		"test:e2e:blocks:table": "playwright test --project=e2e-blocks blocks/table",
		"test:e2e:blocks:image": "playwright test --project=e2e-blocks blocks/image",
		"test:e2e:blocks:blockquote": "playwright test --project=e2e-blocks blocks/blockquote",
		"test:e2e:clipboard": "playwright test --project=e2e-clipboard",
		"test:e2e:selection": "playwright test --project=e2e-selection",
		"test:e2e:sticky-column": "playwright test --project=e2e-sticky-column",
		"test:e2e:simulation": "playwright test --project=e2e-simulation",
		"test:e2e:a11y": "playwright test --project=e2e-a11y",
		"test:e2e:search": "playwright test --project=e2e-search",
		"test:e2e:recordings": "playwright test --project=e2e-recordings",
		"test:e2e:vr": "playwright test --project=e2e-vr",
		"test:e2e:webkit": "node scripts/run-with-env.mjs ENGINE=webkit -- playwright test",
		"test:e2e:firefox": "node scripts/run-with-env.mjs ENGINE=firefox -- playwright test",
		"perf:editor": "vitest bench --run --pool=forks src/lib/test/perf",
		"perf:e2e": "node scripts/run-with-env.mjs PERF=1 -- playwright test --project=e2e-perf",
		"perf:check": "node scripts/run-with-env.mjs PERF=1 PERF_GATE=1 PERF_PROD=1 -- playwright test --project=e2e-perf-prod",
		"conformance:full": "node scripts/run-with-env.mjs CONFORMANCE_FULL=1 -- vitest run src/lib/test/gfm-conformance/full-sweep.test.ts",
		"test:exhaustive": "node scripts/run-with-env.mjs EXHAUSTIVE_FULL=1 -- vitest run src/lib/test/exhaustive",
		"test:editor:property:fresh": "node scripts/run-with-env.mjs PROPERTY_FRESH=1 -- vitest run .property.test src/lib/test/core/directive/roundtrip-coverage.test.ts",
		"format": "prettier --write .",
		"lint": "prettier --check . && npm run docs:pack:check && npm run docs:map:check && npm run lint:eslint",
		"lint:eslint": "eslint .",
		"docs:pack:check": "node scripts/docs/build-docs-pack.mjs",
		"docs:map:check": "node scripts/docs/check-codebase-map.mjs",
		"measure": "node scripts/measure/measure.mjs",
		"behavior": "node scripts/measure/behavior.mjs",
		"docs:capture:modes": "node scripts/run-with-env.mjs DOCS_CAPTURE=1 -- playwright test --project=e2e-capture",
		"package": "svelte-kit sync && svelte-package && node scripts/pack/prune-dist.mjs && vite build --config vite.prebuilt.config.js && npm run build --workspaces",
		"prepack": "npm run package && node scripts/pack/verify-pack.mjs",
		"release:fixme-recheck": "node scripts/release/fixme-recheck.mjs",
		"release:publish": "node scripts/release/check-lockstep.mjs && node scripts/release/check-release-gates.mjs && npm publish --workspaces --include-workspace-root",
		"prepare": "git config core.hooksPath .githooks || exit 0",
		"showcase:react": "node scripts/showcase.mjs react",
		"showcase:vue": "node scripts/showcase.mjs vue"
	},
	"dependencies": {
		"esm-env": "^1.2.2",
		"highlight.js": "^11.12.0"
	},
	"peerDependencies": {
		"katex": "^0.17.0 || ^0.18.0 || ^0.19.0",
		"mermaid": "^11.16.0 || ^12.0.0",
		"svelte": "^5.29.0"
	},
	"peerDependenciesMeta": {
		"katex": {
			"optional": true
		},
		"mermaid": {
			"optional": true
		},
		"svelte": {
			"optional": true
		}
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@eslint/js": "^10.0.1",
		"@fontsource/inter": "^5.3.0",
		"@fontsource/jetbrains-mono": "^5.3.0",
		"@playwright/test": "^1.64.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/package": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/commonmark": "^0.27.10",
		"@types/node": "^26.6.5",
		"commonmark": "0.31.2",
		"eslint": "^10.9.0",
		"eslint-plugin-svelte": "^3.23.1",
		"fast-check": "^4.9.0",
		"globals": "^17.11.0",
		"jsdom": "30.0.1",
		"katex": "^0.19.0",
		"mermaid": "^12.0.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"svelte-eslint-parser": "^1.9.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.2",
		"vite": "^8.3.4",
		"vitest": "^5.0.0",
		"wrangler": "4.153.0"
	},
	"overrides": {
		"lodash-es": "^4.18.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
