{
	"name": "aragonite-parrot",
	"version": "0.1.0",
	"private": true,
	"description": "an animated party parrot for aragonite, started from the plugin template",
	"keywords": [
		"aragonite-plugin",
		"aragonite",
		"markdown-editor"
	],
	"license": "0BSD",
	"type": "module",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./conformance": {
			"types": "./dist/conformance.d.ts",
			"default": "./dist/conformance.js"
		},
		"./style.css": "./dist/style.css",
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"THIRD-PARTY-NOTICES.md"
	],
	"sideEffects": [
		"**/*.css"
	],
	"scripts": {
		"dev": "vite",
		"build": "vite build && tsc -p tsconfig.build.json",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"check:plugin": "aragonite-plugin-check .",
		"prepack": "npm run build"
	},
	"peerDependencies": {
		"@voithos-labs/aragonite": "^0.11.4"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.0",
		"@voithos-labs/aragonite": "0.11.4",
		"typescript": "^6.0.3",
		"vite": "^8.3.4",
		"vitest": "^5.0.0"
	}
}
