{
	"name": "aragonite-vue-example",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite --port 1495 --strictPort --force",
		"build": "vue-tsc --noEmit && vite build && npm ci --prefix vue-3.3 && vite build --mode vue33 --outDir dist-vue33",
		"preview": "vite preview --port 1494 --strictPort",
		"preview:vue33": "vite preview --outDir dist-vue33 --port 1497 --strictPort"
	},
	"dependencies": {
		"@fontsource/inter": "^5.3.0",
		"@fontsource/jetbrains-mono": "^5.3.0",
		"@voithos-labs/aragonite": "file:../..",
		"@voithos-labs/aragonite-admonitions": "file:../../packages/admonitions",
		"@voithos-labs/aragonite-details": "file:../../packages/details",
		"@voithos-labs/aragonite-emoji": "file:../../packages/emoji",
		"@voithos-labs/aragonite-footnotes": "file:../../packages/footnotes",
		"@voithos-labs/aragonite-highlight-occurrences": "file:../../packages/highlight-occurrences",
		"@voithos-labs/aragonite-latex": "file:../../packages/latex",
		"@voithos-labs/aragonite-mermaid": "file:../../packages/mermaid",
		"@voithos-labs/aragonite-parrot": "file:../../packages/parrot",
		"@voithos-labs/aragonite-slash-commands": "file:../../packages/slash-commands",
		"@voithos-labs/aragonite-toc": "file:../../packages/toc",
		"@voithos-labs/aragonite-vue": "file:../../packages/vue",
		"katex": "^0.19.0",
		"mermaid": "^12.0.0",
		"vue": "^3.5.44"
	},
	"devDependencies": {
		"@vitejs/plugin-vue": "^6.0.10",
		"typescript": "^6.0.3",
		"vite": "^8.2.2",
		"vue-tsc": "^3.3.13"
	}
}
