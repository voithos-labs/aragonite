{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"jsx": "react-jsx",
		"strict": true,
		"skipLibCheck": false,
		"noEmit": true,
		"types": ["vite/client"],
		// The adapter suite's shared modules sit outside this app; their package imports read the
		// types installed here, by path, since a `paths` match skips the package's export map.
		"paths": {
			"@voithos-labs/aragonite": ["./node_modules/@voithos-labs/aragonite/dist/index.d.ts"],
			"@voithos-labs/aragonite/*": [
				"./node_modules/@voithos-labs/aragonite/dist/*",
				"./node_modules/@voithos-labs/aragonite/dist/*/index"
			]
		}
	},
	"include": ["src", "vite.config.ts"]
}
