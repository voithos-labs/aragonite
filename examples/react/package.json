{
	"name": "aragonite-react-example",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite --port 1490 --strictPort --force",
		"build": "tsc --noEmit && vite build && npm ci --prefix react-18 && vite build --mode react18 --outDir dist-react18",
		"preview": "vite preview --port 1489 --strictPort",
		"preview:react18": "vite preview --outDir dist-react18 --port 1492 --strictPort"
	},
	"dependencies": {
		"@voithos-labs/aragonite": "file:../..",
		"@voithos-labs/aragonite-react": "file:../../packages/react",
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	},
	"devDependencies": {
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"typescript": "^6.0.3",
		"vite": "^8.2.2"
	}
}
