{
	"name": "aragonite-consumer",
	"private": true,
	"type": "module",
	"scripts": {
		"sync-plugins": "node ../../scripts/smoke/sync-consumer-plugins.mjs",
		"predev": "npm run sync-plugins",
		"prebuild": "npm run sync-plugins",
		"precheck": "npm run sync-plugins",
