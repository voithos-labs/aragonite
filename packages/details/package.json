{
	"name": "@voithos-labs/aragonite-details",
	"version": "0.11.4",
	"description": "collapsible <details> sections for aragonite, the cute markdown editor lib",
	"keywords": [
		"aragonite-plugin",
		"aragonite",
		"markdown-editor",
		"details",
		"collapsible"
	],
	"homepage": "https://aragonite.dev",
	"bugs": {
		"url": "https://github.com/voithos-labs/aragonite/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/voithos-labs/aragonite.git",
		"directory": "packages/details"
	},
	"author": "voithos-labs",
	"type": "module",
	"license": "MPL-2.0",
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/prebuilt/index.js"
		},
		"./conformance": {
			"types": "./dist/conformance.d.ts",
			"svelte": "./dist/conformance.js",
			"default": "./dist/prebuilt/conformance.js"
		},
		"./style.css": "./dist/prebuilt/style.css",
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"sideEffects": [
		"**/*.css"
	],
	"scripts": {
		"build": "svelte-package -i src -o dist && node ../../scripts/pack/strip-declaration-css.mjs dist && vite build",
		"prepack": "npm run build"
	},
	"peerDependencies": {
		"@voithos-labs/aragonite": "0.11.4",
		"svelte": "^5.29.0"
	},
	"peerDependenciesMeta": {
		"svelte": {
			"optional": true
		}
	},
	"devDependencies": {
		"@voithos-labs/aragonite": "file:../.."
	},
	"publishConfig": {
		"access": "public"
	}
}
